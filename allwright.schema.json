{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allwright.dev/schemas/allwright.schema.json",
  "title": "Allwright Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "addr": {
          "type": "string"
        }
      }
    },
    "web": {
      "$ref": "#/$defs/webConfig"
    },
    "mobile": {
      "$ref": "#/$defs/mobileConfig"
    },
    "desktop": {
      "$ref": "#/$defs/desktopConfig"
    },
    "expect": {
      "$ref": "#/$defs/retryConfig"
    },
    "suites": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/suiteConfig"
      }
    }
  },
  "$defs": {
    "launchOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "browserBinary": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "browserConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "enum": ["chromium", "firefox"]
        },
        "binary": {
          "type": "string"
        },
        "launchOptions": {
          "$ref": "#/$defs/launchOptions"
        }
      }
    },
    "mobileAppConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "binary": {
          "type": "string"
        },
        "activity": {
          "type": "string"
        }
      }
    },
    "mobileTargetConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device": {
          "type": "string"
        },
        "app": {
          "$ref": "#/$defs/mobileAppConfig"
        }
      }
    },
    "desktopTargetConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app": {
          "$ref": "#/$defs/mobileAppConfig"
        }
      }
    },
    "webConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "browser": {
          "$ref": "#/$defs/browserConfig"
        }
      }
    },
    "mobileConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "android": {
          "$ref": "#/$defs/mobileTargetConfig"
        },
        "ios": {
          "$ref": "#/$defs/mobileTargetConfig"
        }
      }
    },
    "desktopConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mac": {
          "$ref": "#/$defs/desktopTargetConfig"
        },
        "windows": {
          "$ref": "#/$defs/desktopTargetConfig"
        },
        "linux": {
          "$ref": "#/$defs/desktopTargetConfig"
        }
      }
    },
    "retryConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "intervalMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "suiteConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "addr": {
              "type": "string"
            }
          }
        },
        "web": {
          "$ref": "#/$defs/webConfig"
        },
        "mobile": {
          "$ref": "#/$defs/mobileConfig"
        },
        "desktop": {
          "$ref": "#/$defs/desktopConfig"
        },
        "expect": {
          "$ref": "#/$defs/retryConfig"
        }
      }
    }
  }
}
