{
  "name": "allwright-workspace",
  "private": true,
  "packageManager": "bun@1.2.20",
  "workspaces": [
    "packages/core",
    "packages/vitest"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:core": "npm run build --workspace @allwright.dev/core",
    "build:vitest": "npm run build --workspace @allwright.dev/vitest",
    "example:playground": "npm run example:playground --workspace @allwright.dev/core"
  }
}
